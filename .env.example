# Copiez ce fichier en `.env` puis adaptez les valeurs :  cp .env.example .env
# Ne commitez JAMAIS le fichier .env.

# Générer une clé :
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY='REMPLACE_PAR_UNE_NOUVELLE_CLE_SECRETE'
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Base PostgreSQL (utilisée par le service `db` de docker-compose) ---
POSTGRES_DB=stockflow_db
POSTGRES_USER=stockflow_user
POSTGRES_PASSWORD=change-this-local-password

# Utilisée hors Docker (lancement local). Avec docker compose, elle est
# recalculée automatiquement vers l'hôte `db`.
DATABASE_URL=postgresql://stockflow_user:change-this-local-password@localhost:5432/stockflow_db

LOG_LEVEL=INFO

# Origines front-end autorisées (CORS), séparées par des virgules.
# Inutile en dev avec le proxy Vite ; utile si le front appelle directement :8000.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
