# URL de l'API Django. En développement avec le proxy Vite, garder le chemin relatif.
VITE_API_BASE_URL=/api/v1
# Cible du proxy Vite (dev uniquement)
VITE_DEV_PROXY_TARGET=http://localhost:8000
# En production (front servi sur un autre domaine), utiliser l'URL complète :
# VITE_API_BASE_URL=https://api.exemple.com/api/v1
